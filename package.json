{
  "name": "@noctcore/showcase-kit",
  "version": "0.1.1",
  "description": "Capture, frame and export showcase images of desktop and web apps for READMEs and portfolios.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "showcase": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "screenshot",
    "showcase",
    "playwright",
    "electron",
    "tauri",
    "readme",
    "portfolio",
    "noctcore"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/showcase-kit.git"
  },
  "homepage": "https://github.com/noctcore/showcase-kit#readme",
  "bugs": "https://github.com/noctcore/showcase-kit/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "@lydell/node-pty": ">=1.2.0-beta.15",
    "node-pty": ">=1.1.0",
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "@lydell/node-pty": {
      "optional": true
    },
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@types/node": "^22.20.3",
    "playwright": "1.63.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
