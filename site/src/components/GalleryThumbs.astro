---
/**
 * A compact grid of gallery images for a guide: each one opens the full file
 * (or `href`), with a short label under it. The gallery page has the configs.
 */
import { galleryFile } from './GalleryData';

interface Props {
  items: { file: string; alt: string; label: string; href?: string }[];
  /** Images across on wide screens; two on a phone. */
  cols?: number;
}

const { items, cols = 3 } = Astro.props;
const shown = items.map(item => ({ ...item, image: galleryFile(item.file) }));
---

<ul class="gallery-thumbs not-content" style={`--thumb-cols: ${String(cols)}`}>
  {
    shown.map(({ image, alt, label, href }) => (
      <li>
        <a href={href ?? image.src}>
          <img src={image.src} alt={alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
          <span class="gallery-thumbs-label">{label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
    margin-block: 1.25rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 50rem) {
    .gallery-thumbs {
      grid-template-columns: repeat(var(--thumb-cols), minmax(0, 1fr));
    }
  }
  .gallery-thumbs li {
    margin: 0;
    min-width: 0;
  }
  .gallery-thumbs a {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .gallery-thumbs a:hover {
    color: var(--sl-color-white);
  }
  .gallery-thumbs img {
    width: 100%;
    height: auto;
    border-radius: var(--nc-radius);
  }
  .gallery-thumbs-label {
    font: var(--sl-text-xs) / 1.4 var(--__sl-font-mono);
  }
</style>
