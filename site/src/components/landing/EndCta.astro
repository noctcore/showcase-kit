---
/** The closing line and the two ways in. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="nc-section nc-end not-content" aria-labelledby="write-once">
  <h2 class="nc-h2" id="write-once">Write the config once. Rerun it when the UI changes.</h2>
  <div class="nc-actions">
    <a class="nc-btn nc-btn--primary" href={`${base}/getting-started/`}>Get started</a>
    <a class="nc-btn nc-btn--ghost" href={`${base}/reference/config/`}>Config reference</a>
  </div>
</section>
