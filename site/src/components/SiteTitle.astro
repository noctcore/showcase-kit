---
/**
 * The site title as the noctcore wordmark, then the product: "noctcore /
 * showcase-kit". base.css draws the crescent rule under the wordmark and
 * components.css colours the separator and the product.
 */
import mark from '../assets/mark.svg';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <img src={mark.src} width="32" height="32" alt="" />
  <span class="nc-wordmark" translate="no">noctcore</span>
  <span class="nc-sep" aria-hidden="true">/</span>
  <span class="nc-product" translate="no">{siteTitle}</span>
</a>
